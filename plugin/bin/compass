#!/bin/sh
# Runs the prebuilt compass for this OS and CPU from ../libexec. Claude Code hooks call this
# file by its absolute path; people and other agents can symlink it onto their PATH.

# Resolve symlinks by hand: `readlink -f` is missing on older macOS.
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

case $(uname -s) in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) os=unsupported ;;
esac
case $(uname -m) in
  arm64 | aarch64) arch=arm64 ;;
  x86_64 | amd64) arch=amd64 ;;
  *) arch=unsupported ;;
esac

binary=$root/libexec/compass-$os-$arch
if [ ! -x "$binary" ]; then
  echo "compass: no prebuilt binary for $(uname -s)/$(uname -m) (looked for $binary)" >&2
  # A hook must never block the agent or a commit on a host compass doesn't support.
  [ "$1" = hook ] && exit 0
  exit 1
fi
exec "$binary" "$@"
